<configuration>
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <filter class="dev.gate.logging.CancelledKeyExceptionFilter"/>
        <encoder>
            <pattern>%d{HH:mm:ss} [%level] %logger{20} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- サードパーティライブラリの冗長な INFO を抑制 -->
    <logger name="org.eclipse.jetty" level="WARN"/>
    <logger name="com.zaxxer.hikari" level="WARN"/>
    <logger name="com.mysql" level="WARN"/>
    <logger name="org.slf4j" level="WARN"/>

    <!-- アプリ内ログは LOG_LEVEL 環境変数で制御 (デフォルト INFO) -->
    <root level="${LOG_LEVEL:-INFO}">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>
