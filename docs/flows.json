        { "from": "gate",  "to": "mrec",    "passes": "after: record で statusCode≥500 検出", "note": "" },
        { "from": "mrec",  "to": "discord", "passes": "sendError(method,path,status,body)", "note": "key=METHOD PATH STATUS で 5s デバウンス" },
        { "from": "discord","to": "mrec",   "passes": "HTTP.sendAsync (discarding)", "note": "失敗時 exceptionally で warn ログ" }
      ]
