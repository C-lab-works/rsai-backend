    { "id": "entry",       "label": "ENTRY",           "x": 450,  "divider": 610 },
    { "id": "filters",     "label": "FILTERS",         "x": 770,  "divider": 930 },
    { "id": "controllers", "label": "ROUTING / CONTROLLERS", "x": 1090, "divider": 1250 },
    { "id": "data",        "label": "DATA & CORE",     "x": 1410, "divider": null }
  ],
